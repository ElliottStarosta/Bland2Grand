{
  "version": "2.0.0",
  "tasks": [

    // =========================================================
    // 1. Arduino Flash
    // =========================================================
    {
      "label": "Arduino: Flash",
      "type": "shell",
      "command": "& \"$env:USERPROFILE\\.platformio\\penv\\Scripts\\pio.exe\" run --target upload",
      "options": {
        "cwd": "${workspaceFolder}/Bland2Grand_Arduino"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },

    // =========================================================
    // 2. Serial Monitor
    // =========================================================
    {
      "label": "Arduino: Serial Monitor",
      "type": "shell",
      "command": "& \"$env:USERPROFILE\\.platformio\\penv\\Scripts\\pio.exe\" device monitor --baud 9600",
      "options": {
        "cwd": "${workspaceFolder}/Bland2Grand_Arduino"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },

    // =========================================================
    // 3. Backend
    // =========================================================
    {
      "label": "Backend: Flask",
      "type": "shell",
      "command": "python app.py",
      "options": {
        "cwd": "${workspaceFolder}/bland2grand-backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },

    // =========================================================
    // 4. Frontend
    // =========================================================
    {
      "label": "Frontend: Vite",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0",
      "options": {
        "cwd": "${workspaceFolder}/bland2grand-frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },

    // =========================================================
    // 5. ngrok (FIXED PATH)
    // =========================================================
    {
      "label": "ngrok: Tunnel port 5173",
      "type": "shell",
      "command": "& \"C:\\Users\\starl\\AppData\\Local\\Microsoft\\WinGet\\Packages\\Ngrok.Ngrok_Microsoft.Winget.Source_8wekyb3d8bbwe\\ngrok.exe\" http 5173",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },

    // =========================================================
    // 6. Flash + Serial
    // =========================================================
    {
      "label": "Arduino: Flash + Serial",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Arduino: Flash",
        "Arduino: Serial Monitor"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // =========================================================
    // 7. Full Stack
    // =========================================================
    {
      "label": "Bland2Grand: Full Stack",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Arduino: Flash + Serial",
        "Backend: Flask",
        "Frontend: Vite",
        "ngrok: Tunnel port 5173"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },

    // =========================================================
    // 8. Backend + Frontend only
    // =========================================================
    {
      "label": "Bland2Grand: Backend + Frontend",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Backend: Flask",
        "Frontend: Vite"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}